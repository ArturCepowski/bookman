<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- Used when the session expires or the user logs out (REQ-01). -->
    <action
        android:id="@+id/action_global_login"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.bookman.app.ui.auth.LoginFragment"
        android:label="@string/title_login">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_login_to_apartments"
            app:destination="@id/apartmentListFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.bookman.app.ui.auth.RegisterFragment"
        android:label="@string/title_register">
        <action
            android:id="@+id/action_register_to_apartments"
            app:destination="@id/apartmentListFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/apartmentListFragment"
        android:name="com.bookman.app.ui.apartment.ApartmentListFragment"
        android:label="@string/title_apartments">
        <action
            android:id="@+id/action_apartments_to_reservations"
            app:destination="@id/reservationListFragment" />
        <action
            android:id="@+id/action_apartments_to_form"
            app:destination="@id/apartmentFormFragment" />
        <action
            android:id="@+id/action_apartments_to_profile"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_apartments_to_invitations"
            app:destination="@id/invitationsFragment" />
    </fragment>

    <fragment
        android:id="@+id/reservationListFragment"
        android:name="com.bookman.app.ui.reservation.ReservationListFragment"
        android:label="@string/title_reservations">
        <argument
            android:name="apartmentId"
            app:argType="long" />
        <action
            android:id="@+id/action_reservations_to_detail"
            app:destination="@id/apartmentDetailFragment" />
        <action
            android:id="@+id/action_reservations_to_members"
            app:destination="@id/membersFragment" />
        <action
            android:id="@+id/action_reservations_to_reminders"
            app:destination="@id/notificationSettingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/apartmentDetailFragment"
        android:name="com.bookman.app.ui.apartment.ApartmentDetailFragment"
        android:label="@string/title_apartment">
        <argument
            android:name="apartmentId"
            app:argType="long" />
        <action
            android:id="@+id/action_detail_to_form"
            app:destination="@id/apartmentFormFragment" />
    </fragment>

    <fragment
        android:id="@+id/apartmentFormFragment"
        android:name="com.bookman.app.ui.apartment.ApartmentFormFragment"
        android:label="@string/title_apartment_form">
        <argument
            android:name="apartmentId"
            android:defaultValue="-1L"
            app:argType="long" />
        <action
            android:id="@+id/action_form_to_reservations"
            app:destination="@id/reservationListFragment" />
    </fragment>

    <fragment
        android:id="@+id/membersFragment"
        android:name="com.bookman.app.ui.member.MembersFragment"
        android:label="@string/title_members">
        <argument
            android:name="apartmentId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/invitationsFragment"
        android:name="com.bookman.app.ui.member.InvitationsFragment"
        android:label="@string/title_invitations" />

    <fragment
        android:id="@+id/notificationSettingsFragment"
        android:name="com.bookman.app.ui.notification.NotificationSettingsFragment"
        android:label="@string/title_reminders">
        <argument
            android:name="apartmentId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.bookman.app.ui.profile.ProfileFragment"
        android:label="@string/title_profile" />
</navigation>
