# Copy to backend/.env and fill in. backend/.env is git-ignored – never commit it.
# Format: KEY=VALUE, one per line, no quotes. Real environment variables override these values.

# Required. At least 32 bytes; generate once with: openssl rand -base64 48
BOOKMAN_JWT_SECRET=

# Optional – defaults shown match docker-compose.yml.
#DATABASE_URL=jdbc:postgresql://localhost:5432/bookman
#DATABASE_USER=bookman
#DATABASE_PASSWORD=bookman_dev_password

# Optional – login session length (Q-15).
#BOOKMAN_JWT_TTL=30d

# Optional – reminders (Q-24): "log" (default, nothing is sent) or "fcm" (Firebase Cloud Messaging).
#BOOKMAN_PUSH_PROVIDER=log
# Path to the Firebase service-account JSON key (secret – keep it outside the repository).
#BOOKMAN_FCM_CREDENTIALS=
