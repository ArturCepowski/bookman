# Template for /etc/bookman/bookman.env on the server (docs/deployment.md).
# Copy, fill in, then: sudo chown bookman:bookman /etc/bookman/bookman.env && sudo chmod 600 /etc/bookman/bookman.env
# Plain KEY=VALUE lines, no quotes. The real file must never be committed.

DATABASE_URL=jdbc:postgresql://localhost:5432/bookman
DATABASE_USER=bookman
# openssl rand -hex 24
DATABASE_PASSWORD=
# openssl rand -base64 48 – a new secret for production, not the one from a developer machine
BOOKMAN_JWT_SECRET=
BOOKMAN_PUSH_PROVIDER=fcm
# Firebase service-account key (Project settings → Service accounts → Generate new private key)
BOOKMAN_FCM_CREDENTIALS=/etc/bookman/fcm.json
# Listen only locally; Caddy terminates HTTPS and proxies to 127.0.0.1:8080
SERVER_ADDRESS=127.0.0.1
